<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/serviceCenterTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Service Center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Your Time Slot (15-min intervals)"
        android:textSize="16sp"
        android:textColor="#757575"
        android:layout_marginBottom="16dp" />

    <ListView
        android:id="@+id/slotsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white"
        android:divider="#CCCCCC"
        android:dividerHeight="2dp"
        android:padding="8dp"
        android:layout_marginBottom="16dp" />


    <TextView
        android:id="@+id/selectedSlotTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No slot selected"
        android:textSize="16sp"
        android:textColor="#212121"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/bookSlotButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Book Slot"
        android:textSize="18sp"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white"
        android:padding="16dp"
        android:enabled="false" />

</LinearLayout>
